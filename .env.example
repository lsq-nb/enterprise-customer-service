# 企业智能客服系统 - 环境变量示例
# 复制此文件为 .env 并填入实际值

# ============ 大模型配置 ============
# OpenAI 兼容 API（支持 OpenAI、Azure、阿里云通义、腾讯混元等）
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# 国内模型提供商（可选，二选一）
# 阿里云通义千问
# DASHSCOPE_API_KEY=your_dashscope_key
# DASHSCOPE_MODEL=qwen-max

# 腾讯混元
# TENCENT_CLOUD_SECRET_ID=your_secret_id
# TENCENT_CLOUD_SECRET_KEY=your_secret_key

# ============ 向量数据库配置 ============
# ChromaDB 本地存储路径
CHROMA_PERSIST_DIR=./data/knowledge/chroma_db

# ============ 服务配置 ============
# FastAPI 服务
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# Streamlit 前端
STREAMLIT_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

# ============ 日志配置 ============
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# ============ LangSmith 追踪（可选）============
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=enterprise-customer-service
